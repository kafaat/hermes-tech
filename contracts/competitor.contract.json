{
  "agent_id": "agent_competitor",
  "version": "1.0.0",
  "purpose": "قراءة صفحات عامة لمنافسين محددين وتلخيص الفرق المحسوب آليًا؛ لا دخول حسابات ولا تجاوز حماية.",
  "model": {
    "primary": "gpt-5.4-mini",
    "fallback": null,
    "params": {
      "temperature": 0.1,
      "max_output_tokens": 1024
    }
  },
  "tools": [
    {
      "name": "firecrawl.scrape",
      "scope": "read",
      "side_effects": "none",
      "unit_cost_usd": 0.0,
      "rate_limit": {
        "per_hour": 50,
        "per_day": 200
      }
    },
    {
      "name": "diff.compute",
      "scope": "read",
      "side_effects": "none"
    },
    {
      "name": "report.append",
      "scope": "write_draft",
      "side_effects": "internal"
    }
  ],
  "permissions": {
    "allow": [
      "public:read",
      "report:draft"
    ],
    "deny": [
      "auth:*",
      "customer:read_private",
      "meta:publish",
      "billing:*",
      "payment:*"
    ],
    "proposals": []
  },
  "budget": {
    "budget_class": "monthly_active",
    "per_call_usd": 0.03,
    "per_task_usd": 0.1,
    "class_cap_usd": 0.35,
    "hard_stop": true,
    "alert_threshold_pct": 80
  },
  "retry": {
    "max_attempts": 2,
    "backoff": "exponential",
    "initial_delay_ms": 3000,
    "max_delay_ms": 20000,
    "retryable_errors": [
      "timeout",
      "rate_limit",
      "upstream_5xx"
    ]
  },
  "escalation": {
    "on_repeated_failure": "notify_founder",
    "on_budget_exceeded": "pause_agent",
    "on_unsafe_content": "abort",
    "notification_channel": "founder_slack"
  },
  "audit": {
    "log_level": "info",
    "retention_days": 365,
    "pii_redaction": true,
    "fields_logged": [
      "ts",
      "task_id",
      "customer_id",
      "agent_id",
      "tool",
      "model",
      "tokens_in",
      "tokens_out",
      "cost_usd",
      "duration_ms",
      "outcome",
      "error_code",
      "idempotency_key"
    ]
  },
  "runtime": {
    "max_concurrent_per_customer": 1,
    "timeout_seconds": 300,
    "queue_priority": "low",
    "max_input_tokens": 16000,
    "max_steps": 4,
    "idempotency_key_fields": [
      "customer_id",
      "competitor_url",
      "month_id",
      "check_seq"
    ]
  },
  "feature_flags": {
    "respect_robots_txt": true,
    "block_auth_pages": true,
    "max_monthly_checks": 10
  }
}
