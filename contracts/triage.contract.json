{
  "agent_id": "agent_triage",
  "version": "1.0.0",
  "purpose": "مرحلة ثانية لرصد الشكاوى التي تفوت قائمة الكلمات: تصنيف ثنائي بنموذج صغير؛ يضيف تصعيدًا ولا يلغي تطابقًا ولا يكتب ردًا.",
  "model": {
    "primary": "gpt-5.4-nano",
    "fallback": null,
    "params": {
      "temperature": 0.0,
      "max_output_tokens": 64,
      "seed": 11
    }
  },
  "tools": [
    {
      "name": "queue.classify",
      "scope": "read",
      "side_effects": "none"
    }
  ],
  "permissions": {
    "allow": [
      "queue:classify"
    ],
    "deny": [
      "reply:draft",
      "reply:send",
      "billing:*",
      "payment:*",
      "customer:delete"
    ],
    "proposals": []
  },
  "budget": {
    "budget_class": "monthly_active",
    "per_call_usd": 0.001,
    "per_task_usd": 0.001,
    "class_cap_usd": 0.02,
    "hard_stop": true,
    "alert_threshold_pct": 80
  },
  "retry": {
    "max_attempts": 1,
    "backoff": "none",
    "initial_delay_ms": 500,
    "max_delay_ms": 500,
    "retryable_errors": [
      "timeout"
    ]
  },
  "escalation": {
    "on_repeated_failure": "human_queue",
    "on_budget_exceeded": "pause_agent",
    "on_unsafe_content": "human_queue",
    "notification_channel": "founder_slack"
  },
  "audit": {
    "log_level": "info",
    "retention_days": 365,
    "pii_redaction": true,
    "fields_logged": [
      "ts",
      "task_id",
      "customer_id",
      "agent_id",
      "tool",
      "model",
      "tokens_in",
      "tokens_out",
      "cost_usd",
      "duration_ms",
      "outcome",
      "error_code",
      "idempotency_key"
    ]
  },
  "runtime": {
    "max_concurrent_per_customer": 4,
    "timeout_seconds": 20,
    "queue_priority": "high",
    "max_input_tokens": 2000,
    "max_steps": 1,
    "idempotency_key_fields": [
      "customer_id",
      "message_id"
    ]
  },
  "feature_flags": {
    "escalate_only": true,
    "escalation_threshold_pct": 30
  }
}
