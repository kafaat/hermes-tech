{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes/contracts/registry.schema.json",
  "type": "object",
  "required": [
    "registry_version",
    "generated_at",
    "approved_models",
    "limits",
    "package_limits",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string"
    },
    "approved_models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "vendor",
          "input_usd_per_mtok",
          "output_usd_per_mtok",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "vendor": {
            "type": "string"
          },
          "input_usd_per_mtok": {
            "type": "number",
            "minimum": 0
          },
          "output_usd_per_mtok": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "ai_cap_per_active_customer_month_usd",
        "onboarding_cap_per_new_customer_usd",
        "acquisition_pool_month_usd",
        "max_parallel_agents",
        "circuit_failure_threshold",
        "circuit_cooldown_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "ai_cap_per_active_customer_month_usd": {
          "type": "number",
          "minimum": 0
        },
        "onboarding_cap_per_new_customer_usd": {
          "type": "number",
          "minimum": 0
        },
        "acquisition_pool_month_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_parallel_agents": {
          "type": "integer",
          "minimum": 1
        },
        "circuit_failure_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "circuit_cooldown_seconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "package_limits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "contract",
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^agent_[a-z][a-z0-9_]{2,31}$"
          },
          "contract": {
            "type": "string",
            "pattern": "^[a-z_]+\\.contract\\.json$"
          },
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
