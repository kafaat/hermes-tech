{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes/policies/complaint_keywords.schema.json",
  "type": "object",
  "required": [
    "version",
    "locale",
    "normalization",
    "channels",
    "categories",
    "owner_inquiry_terms",
    "exceptions",
    "triage_unknown_category",
    "acceptance"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locale": {
      "const": "ar-YE"
    },
    "normalization": {
      "type": "object",
      "required": [
        "strip_diacritics",
        "strip_tatweel",
        "unify_alef",
        "ta_marbuta_to_ha",
        "alef_maqsura_to_ya",
        "allowed_proclitics"
      ],
      "additionalProperties": false,
      "properties": {
        "strip_diacritics": {
          "type": "boolean"
        },
        "strip_tatweel": {
          "type": "boolean"
        },
        "unify_alef": {
          "type": "boolean"
        },
        "ta_marbuta_to_ha": {
          "type": "boolean"
        },
        "alef_maqsura_to_ya": {
          "type": "boolean"
        },
        "allowed_proclitics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "channels": {
      "type": "object",
      "required": [
        "patron",
        "client"
      ],
      "additionalProperties": false,
      "properties": {
        "patron": {
          "$ref": "#/$defs/channel"
        },
        "client": {
          "$ref": "#/$defs/channel"
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "sla_minutes",
          "reason",
          "keywords",
          "keywords_ye"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "pricing",
              "quality",
              "legal",
              "safety",
              "refund"
            ]
          },
          "severity": {
            "enum": [
              "high",
              "critical"
            ]
          },
          "sla_minutes": {
            "type": "integer",
            "minimum": 5
          },
          "reason": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "keywords_ye": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "owner_inquiry_terms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phrase",
          "scope",
          "context"
        ],
        "additionalProperties": false,
        "properties": {
          "phrase": {
            "type": "string"
          },
          "scope": {
            "const": "span"
          },
          "context": {
            "type": "string"
          }
        }
      }
    },
    "triage_unknown_category": {
      "type": "object",
      "required": [
        "severity",
        "sla_minutes",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "high",
            "critical"
          ]
        },
        "sla_minutes": {
          "type": "integer",
          "minimum": 5
        },
        "note": {
          "type": "string"
        }
      }
    },
    "acceptance": {
      "const": "policies/acceptance_policy.json"
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": [
        "source",
        "default_route",
        "severity_routes",
        "copy_to_founder"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "default_route": {
          "enum": [
            "owner",
            "founder"
          ]
        },
        "severity_routes": {
          "type": "object",
          "required": [
            "high",
            "critical"
          ],
          "additionalProperties": false,
          "properties": {
            "high": {
              "type": "array",
              "items": {
                "enum": [
                  "owner_whatsapp",
                  "owner_portal",
                  "founder_slack",
                  "founder_sms"
                ]
              }
            },
            "critical": {
              "type": "array",
              "items": {
                "enum": [
                  "owner_whatsapp",
                  "owner_portal",
                  "founder_slack",
                  "founder_sms"
                ]
              }
            }
          }
        },
        "copy_to_founder": {
          "type": "array",
          "items": {
            "enum": [
              "pricing",
              "quality",
              "legal",
              "safety",
              "refund"
            ]
          }
        }
      }
    }
  }
}
