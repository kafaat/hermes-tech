  d [label="تحقق بشري: payments.matched\nverified_by + verified_at", fillcolor="#FFF2CC"];
  e [label="مقترح subscription:activate → approvals"];
  f [label="تفعيل الاشتراك\nحراسة: لا تفعيل دون دفع matched", fillcolor="#FFF2CC"];
