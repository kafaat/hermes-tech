digraph act {
  rankdir=TB; nodesep=0.3; ranksep=0.32;
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#EAF1FB", color="#1F4E79", width=3.6];
  edge [fontname="DejaVu Sans", fontsize=9];
  a [label="عرض وعقد · فاتورة invoices.issued"];
