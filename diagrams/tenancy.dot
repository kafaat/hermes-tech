digraph ten {
  rankdir=LR; nodesep=0.3; ranksep=0.6;
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#EAF1FB", color="#1F4E79"];
  edge [fontname="DejaVu Sans", fontsize=9];
  own [label="authenticated · صاحب منشأة\nauth.uid() ∈ customer_users"];
  op [label="authenticated · مشغّل\napp.is_operator()"];
