{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes/policies/content_rules.schema.json",
  "type": "object",
  "required": [
    "version",
    "locale",
    "convert_arabic_indic_digits",
    "allow_link_domains",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "locale": {
      "const": "ar-YE"
    },
    "convert_arabic_indic_digits": {
      "type": "boolean"
    },
    "allow_link_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "patterns",
          "severity_by_kind",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "kind": {
            "enum": [
              "keyword",
              "regex"
            ]
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "severity_by_kind": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "post": {
                "enum": [
                  "review",
                  "block"
                ]
              },
              "reply": {
                "enum": [
                  "review",
                  "block"
                ]
              },
              "site": {
                "enum": [
                  "review",
                  "block"
                ]
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}